-- The project for GHC's WebAssembly backend without the flag
-- wasm-libsodium: the package as the client alone, Crypto.OPAQUE.Client,
-- which calls @serenity-kit/opaque, and its test program.
--
--   . ~/.ghc-wasm/env
--   npm ci
--   cabal --project-file=cabal-wasm-client.project --builddir=dist-newstyle/wasm-client build all
--   sh scripts/client.sh wasm
--
-- The compiler is the one ghc-wasm-meta installs; CI pins the same.
import: cabal.project

with-compiler: wasm32-wasi-ghc-9.14.1.20260731
with-hc-pkg: wasm32-wasi-ghc-pkg-9.14.1.20260731

-- The module's Template Haskell splice (haskell-halogen-jsbits' browserJS)
-- runs in the compiler's interpreter, which loads a shared object of every
-- package.
shared: True

-- haskell-halogen-jsbits declares the JavaScript the client calls. It is
-- not on Hackage: it comes from one pinned commit of haskell-halogen. Bump
-- the tag deliberately, in its own commit, here and in
-- cabal-js-client.project.
source-repository-package
  type: git
  location: https://github.com/Swordlash/haskell-halogen
  tag: 3459805e6476781961e2d754fe3574af0345ef09
  subdir:
    jsbits
