cabal-version:      3.0
name:               opaque-hs
version:            0.1.0.0
synopsis:           OPAQUE (RFC 9807), the augmented PAKE, over libsodium
description:
  OPAQUE, the augmented password-authenticated key exchange of RFC 9807,
  with its OPRF from RFC 9497, for the suite ristretto255, SHA-512 and the
  3DH key exchange, with a key stretching function chosen by the
  application (Argon2id, or none for the RFC's test vectors). A client
  proves that it knows a password to a server that never sees the password.
  The protocol is written in Haskell; every primitive (ristretto255,
  SHA-512, HMAC-SHA-512, HKDF-SHA-512, Argon2id, random numbers) comes from
  libsodium. It is tested against the RFCs' test vectors, against
  @serenity-kit/opaque (opaque-ke) and against libopaque. It builds
  natively, and for GHC's WebAssembly backend with the flag
  wasm-libsodium. Without that flag there, and on GHC's JavaScript backend,
  the package is the client alone, Crypto.OPAQUE.Client, with the same
  names and types, calling @serenity-kit/opaque. The README says how.
license:            MIT
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
homepage:           https://github.com/Swordlash/opaque-hs
bug-reports:        https://github.com/Swordlash/opaque-hs/issues
category:           Cryptography
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
extra-source-files: cabal-js-client.project
                    cabal-wasm-client.project
                    cabal-wasm.project
                    interop/client-wasm.mjs
                    interop/serenity.mjs
                    jsbits/opaque.js
                    package-lock.json
                    package.json
                    scripts/client.sh
                    scripts/libsodium.sh
                    scripts/reference.sh
                    test-client/driver.js
tested-with:        GHC == 9.10.3, GHC == 9.12.4, GHC == 9.14.1

source-repository head
  type:     git
  location: https://github.com/Swordlash/opaque-hs.git

flag older-libsodium
  description:
    Build against libsodium 1.0.18, which has no HKDF of its own, for a
    machine that must use such a system library (Debian 12's and Ubuntu
    24.04's): HKDF-SHA-512 is then the Haskell polyfill in
    Crypto.OPAQUE.Kdf.Polyfill, over libsodium's HMAC-SHA-512. Without the
    flag (the default) the package needs libsodium 1.0.19 or later and uses
    its crypto_kdf_hkdf_sha512, and the test suite checks the polyfill
    against it.
  default:     False
  manual:      True

flag wasm-libsodium
  description:
    On GHC's WebAssembly backend, build the whole package over a libsodium
    compiled for wasm32-wasi (scripts/libsodium.sh install-wasm builds
    one), which the linker finds through --extra-lib-dirs. Off by default:
    without it the package is there the client alone, Crypto.OPAQUE.Client,
    which calls @serenity-kit/opaque, so that a program for the browser
    does not come to carry libsodium by accident. On wasm32-wasi libsodium
    has no mlock and no guard pages, so a secret is zeroed but never
    locked, and each costs about 320 KiB (WASI's 64 KiB pages); in a
    browser any script on the page can read a wasm program's whole memory.
    No effect on a native build.
  default:     False
  manual:      True

flag reference
  description:
    Build the test suite opaque-reference, which compares this package
    with libopaque, a second implementation of OPAQUE, step by step.
    scripts/reference.sh builds libopaque for it; the README says how.
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wredundant-constraints -Wunused-packages
  default-extensions:
      DerivingStrategies
      DuplicateRecordFields
      LambdaCase
      NamedFieldPuns
      NoFieldSelectors
      OverloadedRecordDot
      OverloadedStrings
      StrictData

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Crypto.OPAQUE.Client
      Crypto.OPAQUE.Types
  build-depends:
      base >= 4.20 && < 5,
      bytestring >= 0.11.5 && < 0.13
  -- Two implementations. Where libsodium is, the package is its own
  -- protocol code over it, and Crypto.OPAQUE.Client its client. Where it
  -- is not (GHC's JavaScript backend, which links no C library, and its
  -- WebAssembly backend without the flag wasm-libsodium), the package is
  -- Crypto.OPAQUE.Client alone, calling @serenity-kit/opaque through
  -- haskell-halogen-jsbits: jsbits/opaque.js is embedded in a WebAssembly
  -- program, and linked by the JavaScript backend.
  if arch(javascript) || (arch(wasm32) && !flag(wasm-libsodium))
    hs-source-dirs: src-serenity
    build-depends:
        haskell-halogen-jsbits >= 0.1 && < 0.2
    if arch(javascript)
      js-sources: jsbits/opaque.js
  else
    hs-source-dirs: src-libsodium
    exposed-modules:
        Crypto.OPAQUE
        Crypto.OPAQUE.Internal
        Crypto.OPAQUE.Kdf
        Crypto.OPAQUE.Kdf.Polyfill
        Crypto.OPAQUE.OPRF
        Crypto.OPAQUE.Secret
        Crypto.OPAQUE.Sodium
    build-depends:
        transformers >= 0.6 && < 0.7
    -- Where libsodium comes from. Natively pkg-config finds it. For
    -- wasm32-wasi cabal would run the host's pkg-config, which knows only
    -- the host's libsodium, so there the library is linked by name and
    -- found through --extra-lib-dirs.
    if arch(wasm32)
      extra-libraries: sodium
    elif flag(older-libsodium)
      pkgconfig-depends: libsodium >= 1.0.18
    else
      pkgconfig-depends: libsodium >= 1.0.19
    if flag(older-libsodium)
      cpp-options: -DOLDER_LIBSODIUM

test-suite opaque-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  other-modules:
      Test.Vectors
      Test.Kdf
      Test.RoundTrip
      Test.Hardening
      Test.Properties
      Test.Memory
      Test.Interop
      Test.KdfAgreement
  if arch(javascript) || (arch(wasm32) && !flag(wasm-libsodium))
    buildable: False
  -- The comparison of the HKDF polyfill with libsodium's own runs only
  -- where libsodium's is there: without older-libsodium.
  if flag(older-libsodium)
    hs-source-dirs: test-older
  else
    hs-source-dirs: test-libsodium
  -- The tests against @serenity-kit/opaque drive a Node process, which a
  -- WASI program cannot start: there one pending example stands for them.
  if arch(wasm32)
    hs-source-dirs: test-wasm
  else
    hs-source-dirs: test-native
    build-depends:
        base64-bytestring >= 1.2 && < 1.3,
        directory,
        process,
        text
  build-depends:
      base,
      bytestring,
      hspec >= 2.10 && < 2.12,
      QuickCheck >= 2.14 && < 2.20,
      opaque-hs

-- This package against libopaque (scripts/reference.sh), with the same
-- random values on both sides and with each side's client against the
-- other's server. Only with the flag reference, since it needs libopaque
-- built; not with older-libsodium, since libopaque is built against
-- libsodium's own HKDF.
test-suite opaque-reference
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-reference
  main-is:          Main.hs
  other-modules:    Reference
  c-sources:        test-reference/cbits/shim.c
  cc-options:       -Wall -Wextra
  if !flag(reference) || flag(older-libsodium) || arch(wasm32) || arch(javascript)
    buildable: False
  else
    pkgconfig-depends: opaque-reference, libsodium >= 1.0.19
  build-depends:
      base,
      bytestring,
      hspec >= 2.10 && < 2.12,
      QuickCheck >= 2.14 && < 2.20,
      opaque-hs

-- The client of the WebAssembly and JavaScript backends, compiled, as a
-- program for Node. Run with no argument it tests itself against
-- serenity-kit's server. Run with the argument serve it answers one command
-- a line, and the native opaque-test drives it against this package's
-- server and client (test-native/Test/Interop.hs, scripts/client.sh). On
-- WebAssembly it is a reactor that exports hs_test, since a command's main
-- cannot wait for a JavaScript promise; interop/client-wasm.mjs runs it.
test-suite opaque-client-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-client
  main-is:          Main.hs
  if arch(javascript) || (arch(wasm32) && !flag(wasm-libsodium))
    build-depends:
        base,
        base64-bytestring >= 1.2 && < 1.3,
        bytestring,
        containers >= 0.6 && < 0.9,
        haskell-halogen-jsbits,
        opaque-hs,
        text
    if arch(javascript)
      js-sources: test-client/driver.js
    if arch(wasm32)
      ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_test"
  else
    buildable: False
